# Copy to supabase/.env.mmax (gitignored), fill in, then:
#   supabase secrets set --env-file supabase/.env.mmax --project-ref mxakigcvckhmyppoiuds
MMAX_SUBSCRIPTION_KEY=
MMAX_API_CLIENT_ID=
MMAX_CREDIT_BASE_URL=https://master-uat-za-apimanagement.azure-api.net/CreditManagement/v1
MMAX_CONSENT_BASE_URL=https://master-uat-za-apimanagement.azure-api.net/ConsentManagement/v3
MMAX_ENV=uat
MM_MODE=mock
MM_IDV_MODE=required
# Identity check passes at finalScore >= this (0-100). 60 = MortgageMAX's own practice (Louis Pires,
# 2026-09-30); decided by Pro Mortgages SA. Left blank or invalid, the code falls back to 100.
MM_IDV_PASS_SCORE=60
MM_CONSENT_TYPES=["818BB417-0963-4DFF-B7E3-09C66F6D0AF9"]
ALLOW_PASSPORT=false
# Optional production hedge (BUILD-PLAN D1) — leave blank unless prod demands a bearer
MMAX_OAUTH_TENANT_ID=
MMAX_OAUTH_CLIENT_SECRET=
# MortgageMAX People domain (BT People Management API v2, 20 Oct 2026): consent keyed to a person record.
# Switched on by MMAX_PEOPLE_BASE_URL; with it set, the three reference ids are required.
# UAT values (Louis Pires, 22 Oct 2026, and the API's own lookups: GET /SourceSystemTypes, /IdentityDocumentTypes,
# /Countries, /PhoneNumberTypes, /EmailAddressTypes):
#   base URL  https://master-uat-za-apimanagement.azure-api.net/PeopleManagement/v2
#   scope     api://PeopleManagementAPI/.default (the default in code)
#   source system 1 = "Test" in UAT — MortgageMAX will add a new one for us in production
#   identity document type: 1 = South African ID (Green ID), 2 = South African Smart ID Card, 5 = Passport;
#     the form does not ask which book the client has, so new persons are created as 2 (the lookup is by
#     the number alone, so a person created elsewhere as 1 is still found)
#   country ZA; phone type 1 = Mobile; email type 1 = Home
MMAX_PEOPLE_BASE_URL=
MMAX_PEOPLE_SCOPE=api://PeopleManagementAPI/.default
MMAX_PEOPLE_SOURCE_SYSTEM_ID=1
MMAX_PEOPLE_ID_DOC_TYPE_ID=2
MMAX_PEOPLE_COUNTRY_ID=ZA
MMAX_PEOPLE_PHONE_TYPE_ID=1
MMAX_PEOPLE_EMAIL_TYPE_ID=1
# There is no SMS step since 12 Oct 2026 (the identity questions verify the person); the old SMS_* and
# SMSPORTAL_* keys are unused and may be left in or removed from the project's secrets.
