# Copy to supabase/.env.mmax (gitignored), fill in, then:
#   supabase secrets set --env-file supabase/.env.mmax --project-ref mxakigcvckhmyppoiuds
MMAX_SUBSCRIPTION_KEY=
MMAX_API_CLIENT_ID=
MMAX_CREDIT_BASE_URL=https://master-uat-za-apimanagement.azure-api.net/CreditManagement/v1
MMAX_CONSENT_BASE_URL=https://master-uat-za-apimanagement.azure-api.net/ConsentManagement/v3
MMAX_ENV=uat
MM_MODE=mock
MM_IDV_MODE=required
# Identity check passes at finalScore >= this (0-100). 60 = MortgageMAX's own practice (Louis Pires,
# 2026-09-30); decided by Pro Mortgages SA. Left blank or invalid, the code falls back to 100.
MM_IDV_PASS_SCORE=60
MM_CONSENT_TYPES=["818BB417-0963-4DFF-B7E3-09C66F6D0AF9"]
ALLOW_PASSPORT=false
# Optional production hedge (BUILD-PLAN D1) — leave blank unless prod demands a bearer
MMAX_OAUTH_TENANT_ID=
MMAX_OAUTH_CLIENT_SECRET=
# There is no SMS step since 12 Oct 2026 (the identity questions verify the person); the old SMS_* and
# SMSPORTAL_* keys are unused and may be left in or removed from the project's secrets.
